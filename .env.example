# Copiar a .env y completar. Nunca subir .env al repo.
# Coincide con docker-compose.yml para desarrollo local.
DATABASE_URL="mysql://sm:sm_local@localhost:3306/sm_repuestos"

# Better Auth: secreto para firmar sesiones (generar con `openssl rand -base64 32`) y URL de la app.
BETTER_AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# Contraseña del usuario de demo que crea `npm run db:seed` (opcional).
# DEMO_PASSWORD=""
